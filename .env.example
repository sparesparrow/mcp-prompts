# Settings the servers read. All are optional; flags override them (see mcp-prompts --help).
# Variables this file used to list (STORAGE_TYPE, PG_CONNECTION_STRING, ENABLE_SSE, HTTP_SERVER,
# MCP_SERVER, MODE and others) are not read by any current code.

# --- What an install serves (mcp-prompts and mcp-prompts-http)

# Profiles of the library to serve, comma-separated: software-dev, embedded-iot, mia-vehicle,
# voice-home, learning-loop. Empty serves the whole library. See deploy/README.md.
#MCP_PROMPTS_PROFILE=software-dev

# Narrow further: all, none, or groups, prompt ids and tag:<tag> entries.
#MCP_PROMPTS_PROMPTS=all
#MCP_PROMPTS_TEMPLATES=all
#MCP_PROMPTS_EXCLUDE=

# MCP capabilities: tools, prompts, resources.
#MCP_PROMPTS_EXPOSE=tools

# Leave out add_prompt, update_prompt and delete_prompt.
#MCP_PROMPTS_READ_ONLY=true

# A library to use instead of the bundled data/prompts, and directories of your own prompts
# to serve beside it (separated by ":", or ";" on Windows).
#PROMPTS_DIR=./data/prompts
#MCP_PROMPTS_DIRS=

# Save add_prompt, update_prompt and delete_prompt here; without it they last until restart.
#MCP_PROMPTS_STATE_DIR=~/.local/share/mcp-prompts

# A JSON file with the options above (keys: profile, prompts, templates, exclude, expose,
# readOnly, promptsDir, dirs, stateDir).
#MCP_PROMPTS_CONFIG=

# trace, debug, info, warn, error, fatal or silent. Logs go to stderr.
#LOG_LEVEL=info

# --- HTTP server only (mcp-prompts-http)

#HOST=127.0.0.1
#PORT=3003

# Bearer token every request except /health, /ready and /version must carry (16 characters or
# more), or a file that holds it. Required to accept writes beyond loopback.
#MCP_PROMPTS_AUTH_TOKEN=
#MCP_PROMPTS_AUTH_TOKEN_FILE=

# Host header names and browser origins to accept, comma-separated.
#MCP_PROMPTS_ALLOWED_HOSTS=
#MCP_PROMPTS_ALLOWED_ORIGINS=
#CORS_ORIGIN=

# Accept writes beyond loopback without a token, for a server behind a proxy that authenticates.
#MCP_PROMPTS_ALLOW_INSECURE=false
