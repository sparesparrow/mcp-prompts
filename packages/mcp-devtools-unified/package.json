{
  "name": "@sparesparrow/mcp-devtools-unified",
  "version": "1.0.0",
  "description": "Unified MCP server for development tooling integration with cognitive architecture",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-devtools-unified": "dist/mcp-devtools-server.js"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && tsc",
    "dev": "nodemon --exec ts-node src/mcp/devtools-server.ts",
    "dev:mcp": "MODE=mcp nodemon --exec ts-node src/mcp/devtools-server.ts",
    "start": "node dist/mcp/devtools-server.js",
    "start:mcp": "MODE=mcp node dist/mcp/devtools-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "development-tools",
    "static-analysis",
    "debugging",
    "git",
    "docker",
    "cognitive-architecture"
  ],
  "author": "sparesparrow",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@sparesparrow/mcp-prompts": "workspace:*",
    "@sparesparrow/mcp-fbs": "workspace:*",
    "flatbuffers": "^23.5.26",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "zod": "^3.25.71"
  },
  "devDependencies": {
    "@types/node": "^20.19.17",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "../mcp-prompts",
    "../mcp-fbs"
  ]
}