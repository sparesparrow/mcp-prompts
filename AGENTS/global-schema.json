{
  "type": "object",
  "properties": {
    "repository_overview": {
      "type": "object",
      "properties": {
        "repository_name": {"type": "string"},
        "owner": {"type": "string"},
        "project_type": {"type": "string"},
        "description": {"type": "string"},
        "architectural_style": {"type": "string"},
        "primary_languages": {"type": "array", "items": {"type": "string"}},
        "frameworks": {"type": "array", "items": {"type": "string"}},
        "key_technologies": {"type": "array", "items": {"type": "string"}},
        "total_components": {"type": "number"}
      },
      "required": ["repository_name", "project_type"]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "location": {"type": "string"},
          "language": {"type": "string"},
          "framework": {"type": "string"},
          "description": {"type": "string"},
          "responsibilities": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "entry_points": {"type": "array", "items": {"type": "string"}},
          "build_system": {"type": "string"},
          "test_framework": {"type": "string"},
          "analysis": {
            "type": "object",
            "properties": {
              "classes_and_modules": {"type": "array", "items": {"type": "string"}},
              "design_patterns": {"type": "array", "items": {"type": "string"}},
              "key_interactions": {"type": "array", "items": {"type": "string"}},
              "identified_issues": {"type": "array", "items": {"type": "string"}},
              "recommendations": {"type": "array", "items": {"type": "string"}}
            }
          },
          "diagram": {"type": "string"}
        },
        "required": ["name", "type", "language"]
      }
    },
    "architectural_insights": {
      "type": "object",
      "properties": {
        "overall_architecture": {"type": "string"},
        "architectural_patterns": {"type": "array", "items": {"type": "string"}},
        "design_patterns": {"type": "array", "items": {"type": "string"}},
        "component_interactions": {"type": "array", "items": {"type": "object"}},
        "data_flow": {"type": "string"},
        "deployment_architecture": {"type": "string"},
        "scalability_notes": {"type": "string"},
        "security_considerations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "diagrams": {
      "type": "object",
      "properties": {
        "overall_architecture": {"type": "string"},
        "component_diagram": {"type": "string"},
        "dependency_graph": {"type": "string"},
        "data_flow_diagram": {"type": "string"},
        "deployment_diagram": {"type": "string"},
        "class_diagrams": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "build_and_deployment": {
      "type": "object",
      "properties": {
        "build_systems": {"type": "array", "items": {"type": "string"}},
        "build_commands": {"type": "array", "items": {"type": "string"}},
        "test_commands": {"type": "array", "items": {"type": "string"}},
        "deployment_procedures": {"type": "array", "items": {"type": "string"}},
        "ci_cd_configuration": {"type": "string"}
      }
    },
    "solid_analysis": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "overall_score": {"type": "number"},
        "principle_scores": {
          "type": "object",
          "properties": {
            "single_responsibility": {"type": "number"},
            "open_closed": {"type": "number"},
            "liskov_substitution": {"type": "number"},
            "interface_segregation": {"type": "number"},
            "dependency_inversion": {"type": "number"}
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "principle": {"type": "string"},
              "severity": {"type": "string"},
              "location": {"type": "string"},
              "description": {"type": "string"},
              "suggestion": {"type": "string"}
            }
          }
        },
        "refactoring_recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {"type": "string"},
              "principle": {"type": "string"},
              "effort": {"type": "string"},
              "impact": {"type": "string"},
              "description": {"type": "string"}
            }
          }
        }
      }
    },
    "github_analysis": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "current_branch": {"type": "string"},
        "total_branches": {"type": "number"},
        "open_prs_count": {"type": "number"},
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "commits_ahead": {"type": "number"},
              "has_pr": {"type": "boolean"},
              "pr_number": {"type": "number"}
            }
          }
        },
        "pull_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {"type": "number"},
              "title": {"type": "string"},
              "branch": {"type": "string"},
              "files_changed": {"type": "number"},
              "changes_summary": {"type": "string"},
              "diagram": {"type": "string"}
            }
          }
        },
        "new_prs_created": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "branch": {"type": "string"},
              "pr_number": {"type": "number"},
              "pr_url": {"type": "string"},
              "title": {"type": "string"}
            }
          }
        }
      }
    },
    "execution_summary": {
      "type": "object",
      "properties": {
        "components_analyzed": {"type": "number"},
        "agents_spawned": {"type": "number"},
        "diagrams_generated": {"type": "number"},
        "execution_time_seconds": {"type": "number"},
        "errors_encountered": {"type": "number"},
        "dry_run": {"type": "boolean"}
      },
      "required": ["components_analyzed", "dry_run"]
    }
  },
  "required": ["repository_overview", "components", "execution_summary"]
}
