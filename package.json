{
  "name": "@sparesparrow/mcp-prompts",
  "version": "4.0.0",
  "description": "Simple MCP server for managing AI prompts and agent configurations with direct claude CLI orchestration",
  "main": "dist/mcp-server-standalone.js",
  "types": "dist/mcp-server-standalone.d.ts",
  "bin": {
    "mcp-prompts": "dist/mcp-server-standalone.js",
    "orchestrate-project": "scripts/orchestrate-project.sh"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples",
    "scripts",
    "data/prompts"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "prompts",
    "templates",
    "llm",
    "ai",
    "agent-orchestration",
    "claude",
    "typescript"
  ],
  "author": "sparesparrow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparesparrow/mcp-prompts.git"
  },
  "bugs": {
    "url": "https://github.com/sparesparrow/mcp-prompts/issues"
  },
  "homepage": "https://github.com/sparesparrow/mcp-prompts#readme",
  "scripts": {
    "build": "tsc && swc src -d dist --strip-leading-paths",
    "build:clean": "pnpm run clean && pnpm run build",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/mcp-server-standalone.ts",
    "start": "node dist/mcp-server-standalone.js",
    "orchestrate": "bash scripts/orchestrate-project.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pino": "^8.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.13.5",
    "@types/node": "^20.19.17",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/mcp-server-standalone.js",
      "require": "./dist/mcp-server-standalone.js",
      "types": "./dist/mcp-server-standalone.d.ts"
    },
    "./package.json": "./package.json"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sparesparrow"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "publishConfig": {
    "access": "public"
  }
}
